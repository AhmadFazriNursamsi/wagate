NODE_ENV=development
# NODE_ENV=production

PORT=3000

# API secret key — generate with: bun run generate-key
SECRET_KEY=

# WhatsApp account phone numbers (required)
WA1_NUMBER=628xxx
WA2_NUMBER=628xxx

# Optional display names for production profile setup
# DISPLAY_NAME_1=Bot Main
# DISPLAY_NAME_2=Bot Secondary

# CATU Cron URL Endpoint
CATU_CRON_URL=https://apps.catu.id/CATUJavaProd/rest/cronparamsromo

# Delivery pacing (optional — defaults keep the original anti-ban timing)
# WARMUP_EVERY=1          # warm-up conversation every N-th message
# SEND_DELAY_MIN_MS=3000  # fixed pause before each send
# SEND_DELAY_RANGE_MS=2000
# TYPING_MIN_MS=1000      # typing indicator duration
# TYPING_MAX_MS=3000

# Defaults for the invite API / dashboard (optional)
# INVITE_GROUP_ID=1203630xxxxxxxx@g.us
# INVITE_LINK=https://chat.whatsapp.com/XXXXXXXX

# Warm-up conversation between Client 1 and Client 2 before sending (optional)
# WARMUP_SESSION_MIN=2        # messages per session: 2 = one message + one reply
# WARMUP_SESSION_MAX=2         # (0 = disable)
# WARMUP_IDLE_MINUTES=30      # new session after this much idle time
# WARMUP_GAP_MIN_MS=3000      # pause between warm-up messages
# WARMUP_GAP_MAX_MS=8000
# WARMUP_REQUIRED=true        # hold the queue until both accounts are connected

# Restart a browser that waited this long (ms) for a QR scan, before WhatsApp logs it out
# QR_RECYCLE_MS=240000

# In production the profile picture is replaced with logo.jpg and the display
# name is set. Set to false to leave your WhatsApp profiles untouched.
# SETUP_PROFILE=true

# Host address the port is published on (docker compose). Default: all interfaces.
# Set to your VPN/LAN IP to keep the dashboard off other networks.
# BIND_ADDR=10.10.3.41

# Timezone for the {salam} greeting (pagi/siang/sore/malam)
# TIMEZONE=Asia/Jakarta
