NODE_ENV=development
# NODE_ENV=production

PORT=3000

# API secret key — generate with: bun run generate-key
SECRET_KEY=

# WhatsApp account phone numbers (required)
WA1_NUMBER=628xxx
WA2_NUMBER=628xxx

# Optional display names for production profile setup
# DISPLAY_NAME_1=Bot Main
# DISPLAY_NAME_2=Bot Secondary

# CATU Cron URL Endpoint
CATU_CRON_URL=https://apps.catu.id/CATUJavaProd/rest/cronparamsromo

# Delivery pacing (optional — defaults keep the original anti-ban timing)
# WARMUP_EVERY=1          # warm-up conversation every N-th message
# SEND_DELAY_MIN_MS=3000  # fixed pause before each send
# SEND_DELAY_RANGE_MS=2000
# TYPING_MIN_MS=1000      # typing indicator duration
# TYPING_MAX_MS=3000
